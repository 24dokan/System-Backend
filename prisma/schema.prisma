// Phase 1, Area 1A. DRAFT for review.
// Money is stored as integer minor units (sen / cents).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- identity & sellers ----------

enum Role {
  ADMIN
  SELLER
  WAREHOUSE_STAFF
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String?
  sellerId     String?
  seller       Seller?  @relation(fields: [sellerId], references: [id])
  // Staff only: what this person may do. An ADMIN user with no role is a super admin (everything allowed).
  staffRoleId  String?
  staffRole    StaffRole? @relation(fields: [staffRoleId], references: [id])
  isActive     Boolean  @default(true)
  // 2FA hook for later
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sellerId])
  @@index([staffRoleId])
}

/// A named set of permissions for company staff. Permission keys are defined in src/permissions/permissions.ts.
model StaffRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

// A brand and a seller are the same thing.
model Seller {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    SellerStatus @default(PENDING)
  logoMediaId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  profile       SellerProfile?
  orders        Order[]
  inbound       InboundShipment[]
  users         User[]
  products      Product[]
  subscriptions Subscription[]
}

/// Company and store details a seller fills in after their account is approved.
/// idNumber and bankAccountNumber are sensitive: staff see them masked unless their role allows it.
model SellerProfile {
  sellerId String @id
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // contact person
  contactFirstName String?
  contactLastName  String?
  idNumber         String? // IC or passport number
  contactEmail     String?
  contactPhone     String?

  // company
  legalName      String?
  sstNumber      String?
  sellerType     String?
  companyAddress String?
  country        String?
  state          String?
  city           String?
  postcode       String?
  womanOwned     Boolean?
  malaysianOwned Boolean?

  // bank account
  bankName          String?
  bankAddress       String?
  bankAccountName   String?
  bankAccountNumber String?

  // store
  storeUrl          String?
  productCategory   String?
  productCountRange String?
  stockedInMalaysia Boolean?
  cartSystem        String?

  // technical contact
  techContactTitle  String?
  techContactName   String?
  techContactEmail  String?
  techContactMobile String?

  // e-invoicing
  tinNumber          String?
  einvoiceContactName String?
  einvoiceEmail      String?

  completedAt DateTime? // set while every required field is filled in
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Who looked at a seller's full sensitive details, and when.
model SellerProfileView {
  id        String   @id @default(uuid())
  sellerId  String
  userId    String
  createdAt DateTime @default(now())

  @@index([sellerId])
}

// ---------- packages ----------

enum BillingPeriod {
  YEARLY
  MONTHLY
}

model Package {
  id                    String        @id @default(uuid())
  name                  String        @unique
  tagline               String?
  priceMinor            Int?          // null when isContactUs
  currency              String        @default("MYR")
  billingPeriod         BillingPeriod @default(YEARLY)
  isContactUs           Boolean       @default(false)
  isPopular             Boolean       @default(false)
  displayOrder          Int           @default(0)
  isActive              Boolean       @default(true)
  maxProducts           Int?          // null = unlimited
  maxSkus               Int?          // default 10 x maxProducts, null = unlimited
  maxMicroStores        Int           @default(1)
  transactionFeePercent Decimal       @default(0) @db.Decimal(5, 2)
  pickupFeeMinor        Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  features      PackageFeatureLink[]
  subscriptions Subscription[]
}

model PackageFeature {
  id           String  @id @default(uuid())
  label        String
  groupName    String?
  displayOrder Int     @default(0)

  links PackageFeatureLink[]
}

model PackageFeatureLink {
  packageId String
  featureId String
  included  Boolean @default(true)
  note      String?

  package Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature PackageFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([packageId, featureId])
}

enum SubscriptionStatus {
  PENDING_APPROVAL
  AWAITING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(uuid())
  sellerId  String
  packageId String
  status    SubscriptionStatus @default(PENDING_APPROVAL)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  seller   Seller    @relation(fields: [sellerId], references: [id])
  package  Package   @relation(fields: [packageId], references: [id])
  payments SubscriptionPayment[]

  @@index([sellerId, status])
}

// Bank details shown to sellers (manual transfer for now).
model PaymentInstruction {
  id            String  @id @default(uuid())
  bankName      String
  accountName   String
  accountNumber String
  referenceHint String?
  isActive      Boolean @default(true)
  updatedAt     DateTime @updatedAt
}

model SubscriptionPayment {
  id             String   @id @default(uuid())
  subscriptionId String
  amountMinor    Int
  currency       String
  reference      String?
  confirmedById  String
  confirmedAt    DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

// ---------- catalog ----------

model Feature {
  id   String @id @default(uuid())
  name String @unique

  products ProductFeature[]
}

model Category {
  id                   String     @id @default(uuid())
  name                 String
  parentId             String?
  parent               Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children             Category[] @relation("CategoryTree")
  commissionPercent    Decimal    @default(0) @db.Decimal(5, 2)
  isActive             Boolean    @default(true)

  products Product[]

  @@unique([parentId, name])
}

// ---------- products ----------

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PENDING_REVISION // approved and live, with an edit awaiting review
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String
  categoryId  String
  name        String
  description String?
  status      ProductStatus @default(DRAFT)
  receivable  Boolean       @default(false) // set on approval, used by inventory (1D)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller    Seller            @relation(fields: [sellerId], references: [id])
  category  Category          @relation(fields: [categoryId], references: [id])
  options   ProductOption[]
  skus      Sku[]
  features  ProductFeature[]
  media     ProductMedia[]
  revisions ProductRevision[]
  events    ApprovalEvent[]

  @@index([sellerId, status])
}

model ProductFeature {
  productId String
  featureId String
  value     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id])

  @@id([productId, featureId])
}

model ProductOption {
  id        String @id @default(uuid())
  productId String
  name      String // e.g. Size
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id       String @id @default(uuid())
  optionId String
  value    String // e.g. M
  position Int    @default(0)

  option  ProductOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  skuLinks SkuOptionValue[]

  @@unique([optionId, value])
}

// One SKU per combination of option values. Stock (1D) attaches here.
model Sku {
  id         String   @id @default(uuid())
  productId  String
  code       String   @unique
  priceMinor Int
  isActive   Boolean  @default(true)
  lowStockLevel Int     @default(10) // alert when sellable stock falls to this number
  createdAt  DateTime @default(now())

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  SkuOptionValue[]
  stockLevels StockLevel[]
  movements   StockMovement[]
  orderItems  OrderItem[]
  returns     ReturnRecord[]
  inboundLines InboundLine[]
  marketplaceSync MarketplaceSync?

  @@index([productId])
}

model SkuOptionValue {
  skuId         String
  optionValueId String

  sku         Sku                @relation(fields: [skuId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id])

  @@id([skuId, optionValueId])
}

// ---------- option library ----------
// The shared list of option names (Size, Colour) and values (S, M, Red) that products use.
// Admins define them; a seller who needs a new one files a request that an admin approves or rejects.

enum LibraryStatus {
  APPROVED
  PENDING
  REJECTED
}

model OptionDefinition {
  id                String        @id @default(uuid())
  name              String
  nameKey           String        @unique // lower-case, trimmed, for matching
  status            LibraryStatus @default(APPROVED)
  requestedBySellerId String?
  rejectionReason   String?
  createdAt         DateTime      @default(now())

  values OptionDefinitionValue[]
}

model OptionDefinitionValue {
  id                  String        @id @default(uuid())
  definitionId        String
  value               String
  valueKey            String
  position            Int           @default(0)
  status              LibraryStatus @default(APPROVED)
  requestedBySellerId String?
  rejectionReason     String?
  createdAt           DateTime      @default(now())

  definition OptionDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, valueKey])
}

// ---------- media ----------

enum MediaKind {
  IMAGE
  VIDEO
  FILE
}

model Media {
  id          String    @id @default(uuid())
  sellerId    String?
  kind        MediaKind
  storageKey  String    // original, never overwritten
  mimeType    String
  sizeBytes   Int
  uploaded    Boolean   @default(false) // true once the file is confirmed in storage
  derivatives Json?     // generated sizes: { "thumb": key, "medium": key, ... }
  createdAt   DateTime  @default(now())

  products ProductMedia[]
}

model ProductMedia {
  productId String
  mediaId   String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id])

  @@id([productId, mediaId])
}

// ---------- approval ----------

enum RevisionStatus {
  PENDING
  APPLIED
  REJECTED
}

model ProductRevision {
  id        String         @id @default(uuid())
  productId String
  changes   Json           // proposed changes, applied on approval
  status    RevisionStatus @default(PENDING)
  createdAt DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  RESUBMIT
  REVISION_SUBMIT
  REVISION_APPROVE
  REVISION_REJECT
}

// Append-only. Never updated or deleted.
model ApprovalEvent {
  id        String         @id @default(uuid())
  productId String
  action    ApprovalAction
  actorId   String
  reason    String?
  createdAt DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}

// ---------- inventory (1D) ----------

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique // short name used in labels, e.g. KL
  name      String
  address   String?
  city      String?
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stock    StockLevel[]
  inbound  InboundShipment[]
  orders   Order[]
  returns  ReturnRecord[]
}

/// Stock of one variation in one warehouse on one shelf. location "" means no shelf recorded.
/// Sellable stock = onHand - reserved. Reserved is promised to open orders. Quarantine (damaged) and
/// inspection (returned, not yet checked) are counted separately and are never sellable.
model StockLevel {
  id          String @id @default(uuid())
  skuId       String
  warehouseId String
  location    String @default("")
  onHand      Int    @default(0)
  reserved    Int    @default(0)
  quarantine  Int    @default(0)
  inspection  Int    @default(0)
  updatedAt   DateTime @updatedAt

  sku         Sku        @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  allocations StockAllocation[]

  @@unique([skuId, warehouseId, location])
  @@index([warehouseId])
}

enum MovementType {
  RECEIVED
  RESERVED
  RELEASED
  SHIPPED
  RETURNED
  RESTOCKED
  DAMAGED
  ADJUSTED
}

/// Append-only history. Every change to a StockLevel writes one row.
model StockMovement {
  id            String       @id @default(uuid())
  skuId         String
  warehouseId   String
  location      String       @default("")
  type          MovementType
  onHandDelta   Int          @default(0)
  reservedDelta Int          @default(0)
  quarantineDelta Int        @default(0)
  inspectionDelta Int        @default(0)
  onHandAfter   Int
  refLabel      String? // e.g. IN-0412, #10482, R-2031
  note          String?
  userId        String?
  createdAt     DateTime     @default(now())

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId, createdAt])
  @@index([createdAt])
}

enum InboundStatus {
  EXPECTED
  RECEIVED
  CANCELLED
}

model InboundShipment {
  id           String        @id @default(uuid())
  code         String        @unique // IN-0412
  sellerId     String
  warehouseId  String
  expectedDate DateTime
  status       InboundStatus @default(EXPECTED)
  note         String?
  receivedAt   DateTime?
  createdById  String
  createdAt    DateTime      @default(now())

  seller    Seller        @relation(fields: [sellerId], references: [id])
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  lines     InboundLine[]

  @@index([status, expectedDate])
}

model InboundLine {
  id          String  @id @default(uuid())
  shipmentId  String
  skuId       String
  expectedQty Int
  receivedQty Int?
  damagedQty  Int?
  location    String?

  shipment InboundShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sku      Sku             @relation(fields: [skuId], references: [id])

  @@unique([shipmentId, skuId])
}

/// What was last told to the marketplaces for each variation. Differences become the "marketplace updates" list.
model MarketplaceSync {
  skuId     String   @id
  syncedQty Int
  syncedAt  DateTime @default(now())

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

/// Running numbers for readable codes (orders, shipments, returns).
model Counter {
  name  String @id
  value Int
}

// ---------- orders (1B) and fulfilment (1C) ----------

enum OrderSource {
  SHOPEE
  LAZADA
  TIKTOK
  STOREFRONT
  OTHER
}

enum OrderStatus {
  TO_PACK
  PACKED
  WAITING_PICKUP
  SHIPPED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid())
  number        Int         @unique // shown as #10482
  source        OrderSource
  externalRef   String? // the marketplace's own order number
  sellerId      String
  warehouseId   String
  status        OrderStatus @default(TO_PACK)
  customerName  String
  customerPhone String?
  address       String
  itemsMinor    Int
  shippingMinor Int         @default(0)
  discountMinor Int         @default(0)
  totalMinor    Int
  currency      String      @default("MYR")
  note          String?
  cancelReason  String?
  placedAt      DateTime    @default(now())
  packedAt      DateTime?
  shippedAt     DateTime?
  cancelledAt   DateTime?
  createdById   String
  createdAt     DateTime    @default(now())

  seller    Seller       @relation(fields: [sellerId], references: [id])
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])
  items     OrderItem[]
  events    OrderEvent[]
  returns   ReturnRecord[]

  @@unique([source, externalRef])
  @@index([status, createdAt])
  @@index([sellerId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id             String @id @default(uuid())
  orderId        String
  skuId          String
  productName    String // copied at order time so history stays correct
  variationLabel String
  skuCode        String
  qty            Int
  unitPriceMinor Int

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         Sku               @relation(fields: [skuId], references: [id])
  allocations StockAllocation[]
  returns     ReturnRecord[]

  @@index([orderId])
}

/// Which shelf row the stock for an order line was set aside from. Used for the pick list.
model StockAllocation {
  id           String @id @default(uuid())
  orderItemId  String
  stockLevelId String
  qty          Int

  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stockLevel StockLevel @relation(fields: [stockLevelId], references: [id])

  @@index([orderItemId])
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  action    String // CREATED, PACKED, READY_FOR_PICKUP, SHIPPED, CANCELLED
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum ReturnStatus {
  TO_INSPECT
  SELLER_CHECK
  RESTOCKED
  DAMAGED
}

model ReturnRecord {
  id            String       @id @default(uuid())
  code          String       @unique // R-2031
  orderId       String?
  orderItemId   String?
  skuId         String
  warehouseId   String
  qty           Int
  reason        String?
  status        ReturnStatus @default(TO_INSPECT)
  inspectionNote String?
  receivedAt    DateTime     @default(now())
  inspectedAt   DateTime?
  inspectedById String?
  createdById   String

  order     Order?     @relation(fields: [orderId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  sku       Sku        @relation(fields: [skuId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])

  @@index([status])
}
