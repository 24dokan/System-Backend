NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/system_backend
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# File storage. "local" keeps files in a folder on this machine. Switch to "s3" for the cloud.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Only needed when STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO...):
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false   # true for MinIO
