# Where the backend runs. The browser never calls this directly; Next.js forwards /api/* to it.
API_URL=http://localhost:3000

# Dev quick-login buttons (login page, `npm run dev` only). Defaults match the backend seed.
# NEXT_PUBLIC_QUICK_ADMIN_EMAIL=admin@example.com
# NEXT_PUBLIC_QUICK_ADMIN_PASSWORD=change-me-now
# NEXT_PUBLIC_QUICK_SELLER_EMAIL=demo-seller@example.com
# NEXT_PUBLIC_QUICK_SELLER_PASSWORD=DemoSeller#2026
